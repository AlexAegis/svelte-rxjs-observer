{
	"name": "svelte-rxjs-observer",
	"description": "A svelte component that makes observing observables easier",
	"version": "0.5.3",
	"license": "MIT",
	"private": false,
	"archetype": {
		"platform": "web",
		"framework": "svelte",
		"language": "ts",
		"kind": "lib"
	},
	"keywords": [
		"javascript",
		"js",
		"managed-by-autotool",
		"reactive",
		"rxjs",
		"sveltejs",
		"ts",
		"typescript"
	],
	"author": {
		"email": "alexaegis@pm.me",
		"name": "AlexAegis",
		"url": "https://www.github.com/AlexAegis"
	},
	"homepage": "https://www.github.com/AlexAegis/svelte-rxjs-observer#readme",
	"repository": "github:AlexAegis/svelte-rxjs-observer",
	"bugs": {
		"url": "https://www.github.com/AlexAegis/svelte-rxjs-observer/issues"
	},
	"type": "module",
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"svelte": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./package.json": "./package.json",
			"./readme": "./readme.md"
		},
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"lint:depcheck": "turbo run lint:depcheck_ --concurrency 6 --cache-dir .cache/turbo --filter svelte-rxjs-observer",
		"lint:depcheck__": "depcheck",
		"lint:es": "turbo run lint:es_ --concurrency 16 --filter svelte-rxjs-observer",
		"lint:es_": "eslint --max-warnings=0 --no-error-on-unmatched-pattern .",
		"lint:es:fix": "turbo run lint:es:fix_ --concurrency 16 --filter svelte-rxjs-observer",
		"lint:es:fix_": "eslint --fix --no-error-on-unmatched-pattern .",
		"lint:format": "turbo run lint:format_ --concurrency 16 --filter svelte-rxjs-observer",
		"lint:format_": "prettier --cache-location .cache/prettier --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss --check .",
		"lint:md": "turbo run lint:md_ --concurrency 16 --filter svelte-rxjs-observer",
		"lint:md_": "remark --frail --no-stdout --silently-ignore .",
		"lint:style": "turbo run lint:style_ --concurrency 16 --filter svelte-rxjs-observer",
		"lint:style:css": "turbo run lint:style:css_ --concurrency 16 --filter svelte-rxjs-observer",
		"lint:style:css_": "stylelint --cache true --cache-strategy content --cache-location .cache/stylelintcache-css --allow-empty-input '**/*.css'",
		"lint:style:html": "turbo run lint:style:html_ --concurrency 16 --filter svelte-rxjs-observer",
		"lint:style:html_": "stylelint --cache true --cache-strategy content --cache-location .cache/stylelintcache-html --allow-empty-input '**/*.{html,svelte,vue,astro,xml,php}'",
		"lint:style:scss": "turbo run lint:style:scss_ --concurrency 16 --filter svelte-rxjs-observer",
		"lint:style:scss_": "stylelint --cache true --cache-strategy content --cache-location .cache/stylelintcache-scss --allow-empty-input '**/*.scss'",
		"lint:svelte": "turbo run lint:svelte_ --concurrency 16 --filter svelte-rxjs-observer",
		"lint:svelte_": "svelte-check --tsconfig ./tsconfig.json",
		"lint:tsc": "turbo run lint:tsc_ --concurrency 16 --filter svelte-rxjs-observer",
		"lint:tsc_": "tsc --noEmit",
		"publint": "BUILD_REASON='publish' turbo run publint_ --concurrency 16 --filter svelte-rxjs-observer",
		"publint_": "publint",
		"test": "turbo run test_ --concurrency 16 --filter svelte-rxjs-observer",
		"test_": "vitest --passWithNoTests --coverage --run",
		"test:watch": "vitest --passWithNoTests --coverage",
		"all": "BUILD_REASON='publish' turbo run all_ --concurrency 16 --filter svelte-rxjs-observer",
		"build": "turbo run build-lib_ --concurrency 16 --cache-dir .cache/turbo --filter svelte-rxjs-observer",
		"build-lib_": "svelte-package --input src",
		"format": "turbo run format_ --concurrency 16 --filter svelte-rxjs-observer",
		"format_": "prettier --cache-location .cache/prettier --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss --write ."
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.js",
			"svelte": "./src/index.js",
			"default": "./src/index.js"
		},
		"./package.json": "./package.json",
		"./readme": "./readme.md"
	},
	"peerDependencies": {
		"rxjs": "^7.8.1",
		"svelte": "^4.0.0 || ^5.0.0"
	},
	"devDependencies": {
		"@alexaegis/eslint-config-svelte": "^0.18.1",
		"@alexaegis/eslint-config-vitest": "^0.18.1",
		"@alexaegis/prettier-config": "^0.18.1",
		"@alexaegis/stylelint-config": "^0.18.1",
		"@alexaegis/svelte-config": "^0.18.1",
		"@alexaegis/ts": "^0.18.1",
		"@alexaegis/vitest": "^0.18.1",
		"@sveltejs/package": "^3.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.19.2",
		"publint": "^0.3.25",
		"stylelint": "^17.16.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-preprocess": "^6.0.5",
		"vitest": "^5.0.5"
	}
}
