{
	"name": "example",
	"version": "0.5.3",
	"private": true,
	"archetype": {
		"platform": "web",
		"framework": "sveltekit",
		"language": "ts",
		"kind": "app"
	},
	"keywords": [
		"managed-by-autotool"
	],
	"repository": {
		"url": "git+https://github.com/AlexAegis/svelte-rxjs-observer.git",
		"type": "git"
	},
	"type": "module",
	"scripts": {
		"lint:es": "turbo run lint:es_ --concurrency 16 --filter example",
		"lint:es_": "eslint --max-warnings=0 --no-error-on-unmatched-pattern .",
		"lint:es:fix": "turbo run lint:es:fix_ --concurrency 16 --filter example",
		"lint:es:fix_": "eslint --fix --no-error-on-unmatched-pattern .",
		"lint:format": "turbo run lint:format_ --concurrency 16 --filter example",
		"lint:format_": "prettier --cache-location .cache/prettier --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss --check .",
		"lint:md": "turbo run lint:md_ --concurrency 16 --filter example",
		"lint:md_": "remark --frail --no-stdout --silently-ignore .",
		"lint:style": "turbo run lint:style_ --concurrency 16 --filter example",
		"lint:style:css": "turbo run lint:style:css_ --concurrency 16 --filter example",
		"lint:style:css_": "stylelint --cache true --cache-strategy content --cache-location .cache/stylelintcache-css --allow-empty-input '**/*.css'",
		"lint:style:html": "turbo run lint:style:html_ --concurrency 16 --filter example",
		"lint:style:html_": "stylelint --cache true --cache-strategy content --cache-location .cache/stylelintcache-html --allow-empty-input '**/*.{html,svelte,vue,astro,xml,php}'",
		"lint:style:scss": "turbo run lint:style:scss_ --concurrency 16 --filter example",
		"lint:style:scss_": "stylelint --cache true --cache-strategy content --cache-location .cache/stylelintcache-scss --allow-empty-input '**/*.scss'",
		"lint:svelte": "turbo run lint:svelte_ --concurrency 16 --filter example",
		"lint:svelte_": "svelte-check --tsconfig ./tsconfig.json",
		"lint:tsc": "turbo run lint:tsc_ --concurrency 16 --filter example",
		"lint:tsc_": "tsc --noEmit",
		"test": "turbo run test_ --concurrency 16 --filter example",
		"test_": "vitest --passWithNoTests --coverage --run",
		"test:watch": "vitest --passWithNoTests --coverage",
		"all": "BUILD_REASON='publish' turbo run all_ --concurrency 16 --filter example",
		"build": "turbo run build-app_ --concurrency 16 --filter example",
		"build-app_": "vite build",
		"build:dependencies": "TARGET_ENV='local' turbo run build-lib_ --concurrency 16 --filter example # used by turbowatch",
		"dev": "turbowatch dev.js",
		"dev_": "TARGET_ENV='local' vite",
		"format": "turbo run format_ --concurrency 16 --filter example",
		"format_": "prettier --cache-location .cache/prettier --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss --write .",
		"kit:sync": "svelte-kit sync",
		"postinstall": "svelte-kit sync",
		"preview": "vite preview",
		"start": "turbo run start_ --concurrency 16 --filter example",
		"start_": "TARGET_ENV='local' vite",
		"start:no-watch": "turbo run start_ --concurrency 16 --cache-dir .cache/turbo --filter example"
	},
	"dependencies": {
		"highlight.js": "^11.9.0",
		"rxjs": "^7.8.1",
		"svelte-rxjs-observer": "workspace:^"
	},
	"devDependencies": {
		"@alexaegis/eslint-config-svelte": "^0.18.1",
		"@alexaegis/eslint-config-vitest": "^0.18.1",
		"@alexaegis/prettier-config": "^0.18.1",
		"@alexaegis/stylelint-config": "^0.18.1",
		"@alexaegis/svelte-config": "^0.18.1",
		"@alexaegis/ts": "^0.18.1",
		"@alexaegis/turbowatch": "^0.18.1",
		"@alexaegis/vite": "^0.18.1",
		"@alexaegis/vitest": "^0.18.1",
		"@skeletonlabs/skeleton": "^5.0.6",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"concurrently": "^8.2.2",
		"stylelint": "^17.16.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"turbowatch": "^2.30.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
