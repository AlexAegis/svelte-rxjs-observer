{
	"name": "svelte-rxjs-observer",
	"description": "A svelte component that makes observing obsevables easier",
	"version": "0.5.3",
	"license": "MIT",
	"private": true,
	"keywords": [
		"javascript",
		"js",
		"managed-by-autotool",
		"reactive",
		"rxjs",
		"sveltejs",
		"ts",
		"typescript"
	],
	"author": {
		"email": "alexaegis@pm.me",
		"name": "AlexAegis",
		"url": "https://www.github.com/AlexAegis"
	},
	"homepage": "https://www.github.com/AlexAegis/svelte-rxjs-observer#readme",
	"repository": "github:AlexAegis/svelte-rxjs-observer",
	"bugs": {
		"url": "https://www.github.com/AlexAegis/svelte-rxjs-observer/issues"
	},
	"type": "module",
	"config": {
		"engine-strict": true
	},
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=9"
	},
	"packageManager": "pnpm@12.15.0",
	"workspaces": [
		"apps/*",
		"examples/*",
		"fixtures/*",
		"libs/*",
		"packages/*"
	],
	"scripts": {
		"lint": "turbo run lint_ --concurrency 16",
		"lint:depcheck": "turbo run lint:depcheck_ --concurrency 16",
		"lint:depcheck_": "depcheck",
		"lint:es": "turbo run lint:es_ --concurrency 16",
		"lint:es:fix": "turbo run lint:es:fix_ --concurrency 16",
		"lint:format": "turbo run lint:format_ --concurrency 16",
		"lint:format_": "prettier --cache-location .cache/prettier --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss --ignore-path .config/workspace-only.prettierignore --check .",
		"lint:md": "turbo run lint:md_ --concurrency 16",
		"lint:md_": "remark --frail --no-stdout --silently-ignore --ignore-pattern packages --ignore-pattern libs --ignore-pattern apps .",
		"lint:rmd": "turbo run lint:rmd",
		"lint:style": "turbo run lint:style_ --concurrency 16",
		"lint:style:css": "turbo run lint:style:css_ --concurrency 16",
		"lint:style:html": "turbo run lint:style:html_ --concurrency 16",
		"lint:style:scss": "turbo run lint:style:scss_ --concurrency 16",
		"lint:svelte": "turbo run lint:svelte_ --concurrency 16",
		"lint:tsc": "turbo run lint:tsc_ --concurrency 16",
		"publint": "BUILD_REASON='publish' turbo run publint_ --concurrency 16",
		"test": "turbo run test_ --concurrency 16 && merge-workspace-lcov-reports && if grep -qs . ./coverage/lcov.info; then lcov-viewer lcov -o ./coverage ./coverage/lcov.info; fi",
		"all": "BUILD_REASON='publish' turbo run all_ --concurrency 16",
		"build": "turbo run build-lib_ build-app_ --concurrency 16",
		"build-app": "turbo run build-app_ --concurrency 16",
		"build-lib": "turbo run build-lib_ --concurrency 16",
		"ce": "turbo run ce_ --concurrency 6 --cache-dir .cache/turbo",
		"dev": "pnpm run --dir apps/example dev",
		"docs": "vitepress dev ./docs/",
		"docs:build": "vitepress build ./docs/",
		"docs:preview": "vitepress preview ./docs/",
		"format": "turbo run format_ --concurrency 16",
		"format_": "prettier --cache-location .cache/prettier --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss --ignore-path .config/workspace-only.prettierignore --write .",
		"ncu": "ncu --configFilePath ./.config/ && pnpm up",
		"nuke": "nuke",
		"postinstall": "husky install && autotool",
		"release": "commit-and-tag-version --sign --commit-all",
		"release:major": "commit-and-tag-version --sign --commit-all --release-as major",
		"release:minor": "commit-and-tag-version --sign --commit-all --release-as minor",
		"release:patch": "commit-and-tag-version --sign --commit-all --release-as patch",
		"start": "pnpm run --dir apps/example start",
		"typedoc": "turbo run typedoc_ --concurrency 16",
		"typedoc_": "typedoc"
	},
	"devDependencies": {
		"@alexaegis/autotool-plugin-commitlint": "^0.18.1",
		"@alexaegis/autotool-plugin-depcheck": "^0.18.1",
		"@alexaegis/autotool-plugin-editorconfig": "^0.18.1",
		"@alexaegis/autotool-plugin-eslint": "^0.18.1",
		"@alexaegis/autotool-plugin-git": "^0.18.1",
		"@alexaegis/autotool-plugin-github": "^0.18.1",
		"@alexaegis/autotool-plugin-husky": "^0.18.1",
		"@alexaegis/autotool-plugin-ncu": "^0.18.1",
		"@alexaegis/autotool-plugin-prettier": "^0.18.1",
		"@alexaegis/autotool-plugin-publint": "^0.18.1",
		"@alexaegis/autotool-plugin-remark": "^0.18.1",
		"@alexaegis/autotool-plugin-standard-version": "^0.18.1",
		"@alexaegis/autotool-plugin-stylelint": "^0.18.1",
		"@alexaegis/autotool-plugin-svelte": "^0.18.1",
		"@alexaegis/autotool-plugin-ts": "^0.18.1",
		"@alexaegis/autotool-plugin-turbo": "^0.18.1",
		"@alexaegis/autotool-plugin-typedoc": "^0.18.1",
		"@alexaegis/autotool-plugin-vite": "^0.18.1",
		"@alexaegis/autotool-plugin-vitepress": "^0.18.1",
		"@alexaegis/autotool-plugin-vitest": "^0.18.1",
		"@alexaegis/autotool-plugin-vscode": "^0.18.1",
		"@alexaegis/autotool-plugin-workspace": "^0.18.1",
		"@alexaegis/coverage-tools": "^0.18.1",
		"@alexaegis/eslint-config-core": "^0.18.1",
		"@alexaegis/nuke": "^0.18.1",
		"@alexaegis/stylelint-config": "^0.18.1",
		"@alexaegis/ts": "^0.18.1",
		"@commitlint/config-conventional": "^20.5.3",
		"@lcov-viewer/cli": "^1.3.0",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^5.0.5",
		"autotool": "^0.8.1",
		"commit-and-tag-version": "^13.3.0",
		"commitlint": "^21.2.1",
		"depcheck": "^1.4.7",
		"eslint": "^10.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"npm-check-updates": "^23.1.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"remark": "^15.0.1",
		"remark-cli": "^12.0.1",
		"stylelint": "^17.16.0",
		"svelte-check": "^4.7.7",
		"ts-node": "^10.9.2",
		"turbo": "^2.11.10",
		"turbo-ignore": "^2.11.10",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitepress": "1.6.4",
		"vitest": "^5.0.5"
	}
}
